{
  "name": "@pm-twin/matching",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Pure post-to-post matching engine — zero I/O, config-injected functions only",
  "main": "./dist/index.js",
  "types": "./index.d.ts",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "dist-types",
    "index.d.ts"
  ],
  "scripts": {
    "build": "node esbuild.js && npm run type-check && npm run declarations",
    "declarations": "tsc --declaration --emitDeclarationOnly --outDir dist-types",
    "type-check": "tsc --noEmit",
    "test": "npm run build && node --test tests/**/*.test.js"
  },
  "devDependencies": {
    "esbuild": "^0.25.0",
    "typescript": "~6.0.2"
  }
}
