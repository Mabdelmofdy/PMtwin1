PORT=3001
NODE_ENV=development
DATABASE_URL=postgresql://pmtwin:pmtwin@localhost:5432/pmtwin?schema=public
JWT_SECRET=local-dev-only-change-me
JWT_ACCESS_TTL=15m
# Reserved for a later refresh-token phase. The scaffold loads these names and
# does not issue, verify, or rotate refresh tokens. No logout or recovery route.
JWT_REFRESH_SECRET=local-dev-only-refresh-change-me
JWT_REFRESH_TTL=7d
# local | forbidden in production
SEED_MODE=local
SEED_ON_BOOT=false
CORS_ORIGIN=http://localhost:5173
SEED_DATA_DIR=../POC/data
